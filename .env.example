# ============================================================
# SERVER
# ============================================================
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# ============================================================
# PAYHERO (from https://payherokenya.com/sps/portal)
# ============================================================
# Basic Auth: base64(username:password)
# Generate with: echo -n "YOUR_USERNAME:YOUR_PASSWORD" | base64
PAYHERO_AUTH_TOKEN=Basic REPLACE_WITH_BASE64_TOKEN

# Your registered payment channel ID from the PayHero portal
PAYHERO_CHANNEL_ID=1234

# PayHero API base URL
PAYHERO_API_BASE=https://backend.payhero.co.ke/api/v2

# PayHero STK endpoint (older v1 — some accounts use this instead)
PAYHERO_STK_LEGACY=https://payherokenya.com/sps/portal/app/stk.php

# ============================================================
# FIREBASE ADMIN SDK
# Download serviceAccountKey.json from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then paste the JSON as a single line here, OR point to the file path
# ============================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# OR set FIREBASE_SERVICE_ACCOUNT_JSON with the entire JSON as a string

# ============================================================
# PRICING
# ============================================================
ACCOUNT_ACTIVATION_FEE_KES=100
UNLOCK_FEE_DEFAULT_KES=15
WITHDRAWAL_NETWORK_FEE_KES=20
MIN_WITHDRAWAL_KES=100
